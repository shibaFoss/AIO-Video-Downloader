<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical">

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnOpenPrivacyPolicy"
    style="@style/Widget.Material3.Button.IconButton.Filled"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:fontFamily="@font/font_family_medium"
    android:text="@string/label_review_privacy_policy"
    android:textAllCaps="false"
    android:textSize="@dimen/normal_text_size"
    app:backgroundTint="@color/style_color_button_primary"
    app:cornerRadius="5dp"
    app:icon="@drawable/ic_policy"
    app:iconGravity="textStart"
    app:iconPadding="10dp"
    app:iconSize="24dp"
    tools:ignore="SpUsage,VisualLintButtonSize,TextSizeCheck" />
</LinearLayout>