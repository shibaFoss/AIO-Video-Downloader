  ~
  ~ About screen layout displaying app information, developer credits,
  ~ legal links, and version details. The layout includes a top app bar,
  ~ a scrollable content area with app info and version footer.
  ~
  ~ @see AboutActivity
  -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/style_color_background"
  android:fitsSystemWindows="true"
  android:orientation="vertical">

  <!-- Top app bar with back button and title -->
  <include
    android:id="@+id/topBar"
    layout="@layout/activity_about_1_p0" />

  <!-- App icon, name, and tagline -->
  <include layout="@layout/activity_about_1_p1" />

  <!-- Scrollable content area -->
  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <!-- Developer credits and legal links -->
      <include layout="@layout/activity_about_1_p3" />

      <!-- Version info and official website link -->
      <include
        android:id="@+id/versionInfo"
        layout="@layout/activity_about_1_p2" />

    </LinearLayout>
  </ScrollView>
</LinearLayout>