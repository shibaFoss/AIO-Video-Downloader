<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical">

  <com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/style_color_card"
    app:cardCornerRadius="5dp"
    app:strokeColor="@color/style_color_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:layout_marginBottom="3dp"
      android:orientation="vertical"
      android:padding="10dp"
      tools:ignore="UselessLeaf">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
          android:layout_width="35dp"
          android:layout_height="35dp"
          android:layout_gravity="top|left"
          android:adjustViewBounds="true"
          android:background="@drawable/bg_color_circle"
          android:backgroundTint="@color/style_color_primary_light"
          android:padding="5dp"
          android:scaleType="centerInside"
          android:tint="@color/style_color_icon"
          app:srcCompat="@drawable/ic_shield_lock_fill" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="top"
          android:layout_marginLeft="10dp"
          android:layout_marginRight="10dp"
          android:orientation="vertical">

          <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_family_bold"
            android:text="@string/label_security"
            android:textColor="@color/style_color_text_primary"
            android:textSize="@dimen/normal_text_size"
            tools:ignore="SpUsage,TextSizeCheck" />

          <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_family_regular"
            android:text="@string/label_we_take_security_seriously"
            android:textColor="@color/style_color_text_secondary"
            android:textSize="@dimen/small_text_size"
            tools:ignore="SpUsage,TextSizeCheck" />
        </LinearLayout>
      </LinearLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="5dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="horizontal">

          <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center_vertical"
            android:adjustViewBounds="true"
            android:background="@drawable/ic_rd_primary_light_color"
            android:backgroundTint="@color/style_color_primary_light"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:tint="@color/style_color_icon"
            app:srcCompat="@drawable/ic_encrypted" />

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="10dp"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:fontFamily="@font/font_family_light"
              android:maxLines="2"
              android:text="@string/label_end_encrypted_storage"
              android:textColor="@color/style_color_text_primary"
              android:textSize="@dimen/smaller_text_size"
              tools:ignore="SpUsage,TextSizeCheck" />
          </LinearLayout>
        </LinearLayout>

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="horizontal">

          <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center_vertical"
            android:adjustViewBounds="true"
            android:background="@drawable/ic_rd_primary_light_color"
            android:backgroundTint="@color/style_color_primary_light"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:tint="@color/style_color_icon"
            app:srcCompat="@drawable/ic_assured_workload" />

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="10dp"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:fontFamily="@font/font_family_light"
              android:maxLines="2"
              android:text="@string/label_no_password_collection"
              android:textColor="@color/style_color_text_primary"
              android:textSize="@dimen/smaller_text_size"
              tools:ignore="SpUsage,TextSizeCheck" />
          </LinearLayout>
        </LinearLayout>

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="horizontal">

          <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center_vertical"
            android:adjustViewBounds="true"
            android:background="@drawable/ic_rd_primary_light_color"
            android:backgroundTint="@color/style_color_primary_light"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:tint="@color/style_color_icon"
            app:srcCompat="@drawable/ic_graph_3" />

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="10dp"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:fontFamily="@font/font_family_light"
              android:maxLines="2"
              android:text="@string/label_secure_https_connections"
              android:textColor="@color/style_color_text_primary"
              android:textSize="@dimen/smaller_text_size"
              tools:ignore="SpUsage,TextSizeCheck" />
          </LinearLayout>
        </LinearLayout>

      </LinearLayout>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</LinearLayout>