  ~
  ~ Layout for the Terms and Conditions introduction / header section.
  ~ This component displays the last updated date and an introductory
  ~ text explaining the purpose of the terms document.
  ~
  ~ The layout includes:
  ~   - Last updated date row with calendar icon and bold date text
  ~   - Introductory text describing the terms and conditions
  ~   - Divider line separating the header from the terms content
  ~
  ~ @see TermsPolicyActivity
  ~ @see R.id#termsIntro
  -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="vertical">

  <!-- Last updated date row -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ic_rd_bg_secondary_color"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Calendar icon -->
    <ImageView
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_marginEnd="10dp"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_calender"
      android:tint="@color/style_color_icon"
      tools:ignore="UseAppTint" />

    <!-- Label: "Last Updated" -->
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginRight="5dp"
      android:fontFamily="@font/font_family_medium"
      android:text="@string/label_last_updated"
      android:textColor="@color/style_color_text_primary"
      android:textSize="@dimen/normal_text_size"
      tools:ignore="SpUsage,TextSizeCheck" />

    <!-- Date value (bold, link color) -->
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/font_family_bold"
      android:text="@string/label_last_updated_date"
      android:textColor="@color/style_color_text_link"
      android:textSize="@dimen/normal_text_size"
      tools:ignore="SpUsage,TextSizeCheck,TextContrastCheck" />

  </LinearLayout>

  <!-- Introductory text -->
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:fontFamily="@font/font_family_medium"
    android:text="@string/text_terms_intro"
    android:textColor="@color/style_color_text_secondary"
    android:textSize="@dimen/message_text_size"
    tools:ignore="SpUsage,TextSizeCheck,TextContrastCheck" />

  <!-- Divider line -->
  <View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="10dp"
    android:background="@color/style_color_divider" />

</LinearLayout>