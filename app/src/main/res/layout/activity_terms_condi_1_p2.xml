<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Copyright (c) 2024 TubeAIO. All rights reserved.
  ~
  ~ Layout for the action button section in the Terms and Conditions screen.
  ~ This component provides a single primary action button that allows users
  ~ to agree to the terms and conditions and proceed to the next screen.
  ~
  ~ The button uses a filled Material 3 style with a checkmark icon positioned
  ~ at the start (left) of the button text. The icon includes padding for proper
  ~ spacing between the icon and text.
  ~
  ~ @see TermsPolicyActivity
  ~ @see R.id#btnAgreeContinue
  -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical">

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnAgreeContinue"
    style="@style/Widget.Material3.Button.IconButton.Filled"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:fontFamily="@font/font_family_medium"
    android:text="@string/label_agree_continue"
    android:textAllCaps="false"
    android:textSize="@dimen/normal_text_size"
    app:backgroundTint="@color/style_color_button_primary"
    app:cornerRadius="5dp"
    app:icon="@drawable/ic_okay_check"
    app:iconGravity="textStart"
    app:iconPadding="10dp"
    app:iconSize="24dp"
    tools:ignore="SpUsage,VisualLintButtonSize,TextSizeCheck" />
</LinearLayout>