  ~
  ~ Application themes and styles defining the visual appearance of the app.
  ~ Includes main application theme, video player theme, transparent theme
  ~ for dialogs, and reusable widget styles.
  ~
  ~ Theme hierarchy:
  ~   - style.application - Main app theme (Material3 Dark, NoActionBar)
  ~   - style.application.video_player_activity - Video player variant with cutout
  ~   - style.transparent_activity - Transparent theme for overlays/dialogs
  ~   - style_webview_loading - WebView progress bar style
  ~   - style_padding_textview_style - TextView padding and spacing reset
  ~
  ~ @see AndroidManifest.xml
  ~ @see styles.xml
  -->
<resources>

  <!-- Main Application Theme -->
  <style name="style.application" parent="Theme.Material3.Dark.NoActionBar">

    <!-- App Colors -->
    <item name="colorPrimary">@color/style_color_primary</item>
    <item name="colorError">@color/style_color_error</item>

    <!-- Window -->
    <item name="android:windowBackground">@color/style_color_background</item>
    <item name="android:statusBarColor">@color/style_color_background</item>
    <item name="android:navigationBarColor">@color/style_color_background</item>

    <!-- System Bar Icons (Dark Theme) -->
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>

    <!-- Typography -->
    <item name="android:fontFamily">@font/style_app_fonts</item>

    <!-- Text Colors -->
    <item name="android:textColorPrimary">@color/style_color_text_primary</item>
    <item name="android:textColorSecondary">@color/style_color_text_secondary</item>
    <item name="android:textColorHint">@color/style_color_text_hint</item>
    <item name="android:textColorLink">@color/style_color_text_link</item>
    <item name="android:autofilledHighlight">@color/style_color_transparent</item>

    <!-- Widget Styles -->
    <item name="android:textViewStyle">@style/style_padding_textview_style</item>
    <item name="android:checkboxStyle">@style/style_padding_textview_style</item>
    <item name="android:switchStyle">@style/style_padding_textview_style</item>

  </style>

  <!-- Video Player Theme (allows display cutout) -->
  <style name="style.application.video_player_activity" parent="style.application">
    <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    <item name="android:windowTranslucentStatus">true</item>
    <item name="android:windowTranslucentNavigation">true</item>
    <item name="android:fitsSystemWindows">false</item>
  </style>

  <!-- Transparent Theme for Dialog/Overlay Activities -->
  <style name="style.transparent_activity" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="android:statusBarColor">@color/style_color_surface</item>
    <item name="android:navigationBarColor">@color/style_color_surface</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:windowActivityTransitions">false</item>

    <item name="android:windowBackground">@color/style_color_transparent</item>
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowIsFloating">false</item>
    <item name="android:backgroundDimEnabled">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowActionBarOverlay">false</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:windowCloseOnTouchOutside">true</item>

    <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    <item name="android:windowTranslucentStatus">false</item>
    <item name="android:windowTranslucentNavigation">true</item>
    <item name="android:fitsSystemWindows">true</item>

    <item name="colorPrimary">@color/style_color_primary</item>
    <item name="colorPrimaryDark">@color/style_color_primary_variant</item>
    <item name="colorError">@color/style_color_error</item>
    <item name="colorAccent">@color/style_color_secondary</item>

    <item name="android:layoutDirection">ltr</item>

    <item name="android:scrollbars">none</item>
    <item name="android:fadeScrollbars">true</item>
    <item name="android:scrollbarThumbVertical">@android:color/transparent</item>
    <item name="android:scrollbarThumbHorizontal">@android:color/transparent</item>

    <item name="android:textColorPrimary">@color/style_color_text_primary</item>
    <item name="android:textColorSecondary">@color/style_color_text_secondary</item>
    <item name="android:textColorHint">@color/style_color_secondary_variant</item>
    <item name="android:textColor">@color/style_color_text_primary</item>
    <item name="android:textColorLink">@color/style_color_secondary</item>

    <item name="android:fontFamily">@font/style_app_fonts</item>
    <item name="android:textViewStyle">@style/style_padding_textview_style</item>
    <item name="android:checkboxStyle">@style/style_padding_textview_style</item>
  </style>

  <!-- WebView Loading Progress Bar Style -->
  <style name="style_webview_loading" parent="android:Widget.ProgressBar.Horizontal">
    <item name="android:indeterminateOnly">false</item>
    <item name="android:progressDrawable">@drawable/ic_webview_progress</item>
    <item name="android:minHeight">@dimen/_4</item>
  </style>

  <!-- TextView Padding Reset Style -->
  <style name="style_padding_textview_style">
    <item name="android:includeFontPadding">false</item>
    <item name="android:lineSpacingMultiplier">1</item>
  </style>
</resources>