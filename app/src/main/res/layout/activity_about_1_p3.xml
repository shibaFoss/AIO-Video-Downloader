  ~
  ~ Contact section with "Get in Touch" options including email, Twitter, and website.
  ~ Displays a card with icon, title, description, and three action buttons.
  -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <!-- Get in Touch Card -->
  <com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginTop="5dp"
    android:layout_marginRight="10dp"
    app:cardBackgroundColor="@color/style_color_card"
    app:cardCornerRadius="5dp"
    app:strokeColor="@color/style_color_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="15dp">

      <!-- Header with icon and title -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:layout_width="45dp"
          android:layout_height="45dp"
          android:background="@drawable/bg_color_circle"
          android:backgroundTint="@color/style_color_primary_light"
          android:padding="10dp"
          android:src="@drawable/ic_email_box"
          android:tint="@color/style_color_primary"
          tools:ignore="ContentDescription,UseAppTint" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginLeft="15dp"
          android:orientation="vertical">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_family_bold"
            android:text="@string/label_get_in_touch"
            android:textColor="@color/style_color_text_primary"
            android:textSize="@dimen/normal_text_size"
            tools:ignore="SpUsage,TextSizeCheck" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:fontFamily="@font/font_family_regular"
            android:text="@string/desc_we_d_love_to_hear_from_you"
            android:textColor="@color/style_color_text_secondary"
            android:textSize="@dimen/message_text_size"
            tools:ignore="SpUsage,TextSizeCheck" />
        </LinearLayout>
      </LinearLayout>

      <!-- Action buttons row -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Email Us -->
        <LinearLayout
          android:id="@+id/btnEmailUs"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:orientation="horizontal"
          android:padding="8dp"
          tools:ignore="TouchTargetSizeCheck">

          <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_email_box"
            android:tint="@color/style_color_primary"
            tools:ignore="ContentDescription,UseAppTint" />

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:fontFamily="@font/font_family_regular"
            android:text="@string/label_email_us"
            android:textColor="@color/style_color_text_primary"
            android:textSize="@dimen/message_text_size"
            tools:ignore="SpUsage,TextSizeCheck" />
        </LinearLayout>

        <View
          android:layout_width="1dp"
          android:layout_height="20dp"
          android:layout_marginLeft="5dp"
          android:layout_marginRight="5dp"
          android:background="@color/style_color_divider" />

        <!-- Twitter -->
        <LinearLayout
          android:id="@+id/btnTwitter"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:orientation="horizontal"
          android:padding="8dp"
          tools:ignore="TouchTargetSizeCheck">

          <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_twitter_logo"
            android:tint="@color/style_color_primary"
            tools:ignore="ContentDescription,UseAppTint" />

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:fontFamily="@font/font_family_regular"
            android:text="@string/label_twitter"
            android:textColor="@color/style_color_text_primary"
            android:textSize="@dimen/message_text_size"
            tools:ignore="SpUsage,TextSizeCheck" />
        </LinearLayout>

        <View
          android:layout_width="1dp"
          android:layout_height="20dp"
          android:layout_marginLeft="5dp"
          android:layout_marginRight="5dp"
          android:background="@color/style_color_divider" />

        <!-- Website -->
        <LinearLayout
          android:id="@+id/btnWebsite"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:orientation="horizontal"
          android:padding="8dp"
          tools:ignore="TouchTargetSizeCheck">

          <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_browser_pointer"
            android:tint="@color/style_color_primary"
            tools:ignore="ContentDescription,UseAppTint" />

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:fontFamily="@font/font_family_regular"
            android:text="@string/label_website"
            android:textColor="@color/style_color_text_primary"
            android:textSize="@dimen/message_text_size"
            tools:ignore="SpUsage,TextSizeCheck" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</LinearLayout>