<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/style_color_background"
  android:fitsSystemWindows="true"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
      android:id="@+id/topBar"
      layout="@layout/activity_privacy_policy_1_p0" />

    <include
      android:id="@+id/configurations"
      layout="@layout/activity_privacy_policy_1_p1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginLeft="10dp"
      android:layout_marginRight="10dp" />

    <include
      android:id="@+id/safetyBadges"
      layout="@layout/activity_privacy_policy_1_p2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginLeft="10dp"
      android:layout_marginTop="10dp"
      android:layout_marginRight="10dp" />

    <include
      android:id="@+id/safetyBadges2"
      layout="@layout/activity_privacy_policy_1_p3"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginLeft="10dp"
      android:layout_marginTop="10dp"
      android:layout_marginRight="10dp" />

  </LinearLayout>
</LinearLayout>