          android:text="@string/title_use_of_app"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/normal_text_size"
          tools:ignore="SpUsage,TextSizeCheck" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/font_family_regular"
          android:text="@string/desc_use_of_app"
          android:textColor="@color/style_color_text_secondary"
          android:textSize="@dimen/message_text_size"
          tools:ignore="SpUsage,VisualLintLongText,TextSizeCheck,TextContrastCheck" />
      </LinearLayout>

      <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="10dp"
        android:adjustViewBounds="true"
        android:src="@drawable/ic_arrow_right"
        android:tint="@color/style_color_icon_hint"
        tools:ignore="ContentDescription,UseAppTint,ImageContrastCheck" />
    </LinearLayout>

    <TextView
      android:id="@+id/extraUseOfApp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
